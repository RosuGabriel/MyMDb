# Copy this file to .env and fill in the values
ENVIRONMENT_TYPE=Development

# Database
SA_PASSWORD=your_secure_password_here

# API (only used by docker-compose.yml, prod uses Production explicitly)
HOST_USER_ID=100
HOST_GROUP_ID=100
APPSETTINGS_PATH=your_path/appsettings.json
WWWROOT_PATH=your_path/wwwroot